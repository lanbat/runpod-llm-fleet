{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "runpod": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RunPod (Qwen3.8-27B)",
      "options": {
        "baseURL": "https://api.runpod.ai/v2/h8ins1a7nls350/openai/v1",
        "apiKey": "{file:~/.config/envman/RUNPOD.key}",
        // RunPod's sync route sends no SSE bytes while a scale-to-zero worker cold-starts
        // (~4.5 min: 31 GB checkpoint download, KV-cache profiling, CUDA graph capture), so
        // the whole cold start is charged to chunkTimeout. At the old 180000 every first
        // request after idle aborted with "SSE read timed out" and orphaned its job on the
        // single worker, so retries stacked up behind it (see features/cold_start_timeout.feature).
        // 420000 = 5 min cold-start ceiling + 2 min full-context prefill margin.
        "timeout": 1800000,
        "chunkTimeout": 420000
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B FP8 (RunPod)",
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            // Endpoint MAX_MODEL_LEN is 122880. opencode compacts only after a step pushes the
            // prompt past context - 32000, so the next request can overshoot by one step's tool
            // output; keep 16K below MAX_MODEL_LEN for it (see features/context_budget.feature).
            "context": 106496,
            "output": 32768
          },
          "options": {
            "reasoningEffort": "low"
          },
          // Qwen3.8's chat template only accepts low / medium / xhigh ("high" is a 400).
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "xhigh" }
          }
        }
      }
    }
  }
}
