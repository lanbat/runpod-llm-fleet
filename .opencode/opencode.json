{
  "$schema": "https://opencode.ai/config.json",
  "model": "runpod/qwen3-coder-next",
  "small_model": "runpod/qwen3-coder-next",
  "default_agent": "build",
  "shell": "/bin/zsh",
  "logLevel": "INFO",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,
  "instructions": ["../../.opencode/instructions.md"],
  "skills": {
    "paths": [],
    "urls": []
  },
  "references": {},
  "agent": {
    "plan": {
      "disable": false
    },
    "build": {
      "model": "runpod/qwen3-coder-next",
      "description": "Build agent using RunPod-hosted Qwen3 Coder Next"
    }
  },
  "command": {},
  "disabled_providers": [],
  "enabled_providers": ["runpod"],
  "mcp": {},
  "plugin": [],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "plan_enter": "allow",
    "plan_exit": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "/tmp/*": "allow",
      "/home/traph/projects/**": "allow",
      "/home/traph/.local/share/opencode/**": "allow",
      "*": "ask"
    }
  },
  "formatter": false,
  "lsp": false,
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 32768
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 15,
    "reserved": 16000
  },
  "watcher": {
    "ignore": ["**/.opencode/node_modules/**", "**/node_modules/**", "**/.git/**"]
  }
}
