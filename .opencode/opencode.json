{
  "$schema": "https://opencode.ai/config.json",
  "model": "runpod:qwen3-coder-30b",
  "small_model": "runpod:qwen3-coder-30b",
  "default_agent": "build",
  "shell": "/bin/zsh",
  "logLevel": "INFO",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,
  "instructions": [],
  "skills": {
    "paths": [".opencode/skills"],
    "urls": []
  },
  "references": {},
  "agent": {
    "build": {
      "model": "runpod:qwen3-coder-30b",
      "mode": "subagent",
      "description": "Build agent using RunPod-hosted Qwen3 Coder"
    }
  },
  "command": {},
  "disabled_providers": [],
  "enabled_providers": ["runpod", "anthropic"],
  "mcp": {},
  "plugin": ["opencode-claude-auth@latest"],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "external_directory": {
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/*": "allow",
      "/private/var/folders/*": "allow",
      "*": "ask"
    }
  },
  "formatter": false,
  "lsp": false,
  "experimental": {
    "primary_tools": ["edit"],
    "mcp_timeout": 30000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}