{
  "$schema": "https://opencode.ai/config.json",
  "model": "runpod/qwen3.8-27b",
  "small_model": "runpod/qwen3.8-27b",
  "default_agent": "build",
  "shell": "/bin/zsh",
  "logLevel": "INFO",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "instructions": ["~/.config/opencode/instructions.md"],
  "enabled_providers": ["runpod"],
  "disabled_providers": [],
  "plugin": [],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "plan_enter": "deny",
    "plan_exit": "deny",
    "doom_loop": "ask",
    "external_directory": {
      "/tmp/*": "allow",
      "/home/traph/projects/**": "allow",
      "/home/traph/.local/share/opencode/**": "allow",
      "*": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 20,
    "reserved": 16000
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/.direnv/**",
      "**/result/**",
      "**/.opencode/node_modules/**",
      "**/__pycache__/**",
      "**/.venv/**"
    ]
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 32768
  },
  "formatter": false,
  "lsp": false,
  "subagent_depth": 1,
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "model": "runpod/qwen3.8-27b",
      "description": "Primary agent — implement features, edit files, run commands",
      "permission": {
        "plan_enter": "deny",
        "plan_exit": "deny"
      }
    }
  }
}
